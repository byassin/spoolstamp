{
  "name": "spoolstamp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "sync:catalog": "node scripts/sync-catalog.mjs",
    "sync:studio-presets": "node scripts/sync-studio-presets.mjs",
    "sync:catalog:store": "node scripts/sync-catalog.mjs --with-store",
    "sync:catalog:store:refresh": "node scripts/sync-catalog.mjs --with-store --refresh-handles",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "oxlint app components/label-preview.tsx components/filament-selectors.tsx components/color-swatch.tsx components/ams-panel.tsx hooks lib scripts tests types",
    "format": "oxfmt"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource/noto-sans": "5.3.0",
    "@shuding/opentype.js": "1.4.0-beta.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "1.31.0",
    "manifold-3d": "^3.5.1",
    "mqtt": "5.15.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@cloudflare/workers-types": "5.20260904.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "shadcn": "4.21.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "4.129.0"
  },
  "type": "module"
}
